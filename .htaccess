# Mochi Cards auf normalem Webspace:
# Der gesamte Ordner wird hochgeladen; ausgeliefert wird ausschließlich der Unterordner /public.
# Alle anderen Dateien (.env, Datenbank, Programmcode) sind von außen nicht erreichbar.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Ohne mod_rewrite lieber gar nichts ausliefern als interne Dateien.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</IfModule>

<FilesMatch "^\.env|\.sqlite$|^composer\.(json|lock)$|^artisan$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes
